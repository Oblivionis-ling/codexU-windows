{
  "name": "codex-usage",
  "version": "1.0.0",
  "description": "Compact Windows desktop widget for Codex quota, resets and subscription value.",
  "main": "src/main.js",
  "author": "Oblivionis-ling",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \".github/**/*.yml\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@openai/codex": "0.142.5"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.6.0",
    "prettier": "^3.9.5"
  },
  "build": {
    "appId": "io.github.oblivionisling.codexusage",
    "productName": "Codex-Usage",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-win32-x64/**",
      "node_modules/@openai/codex/**/vendor/**"
    ],
    "win": {
      "icon": "src/assets/codex-usage.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Codex-Usage-${version}-portable.${ext}"
    }
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
